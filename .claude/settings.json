{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Skill",
      "ToolSearch",
      "Agent",
      "SendMessage",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(PYTHONIOENCODING=utf-8 python *)",
      "Bash(pip install *)",
      "Bash(curl *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sed -n *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(jq *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(date *)",
      "Bash(which *)",
      "Bash(cd *)",
      "Bash(for *)",
      "Bash(echo *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git mv *)",
      "Bash(git push origin HEAD*)",
      "Bash(git push -u origin *)",
      "Bash(git clone --depth 1 * /tmp/*)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(md5sum *)",
      "Bash(mkdir -p *)",
      "mcp__github__get_file_contents",
      "mcp__github__search_code",
      "mcp__github__search_repositories",
      "mcp__github__list_commits",
      "mcp__github__list_tags",
      "mcp__github__list_releases",
      "mcp__github__get_commit",
      "mcp__github__get_tag",
      "mcp__github__get_latest_release",
      "mcp__github__get_release_by_tag",
      "mcp__github__get_latest_release",
      "mcp__github__list_branches",
      "mcp__context7",
      "mcp__claude_ai_Context7",
      "mcp__claude_ai_Hugging_Face",
      "mcp__hf-mcp-server",
      "mcp__Context7"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git tag*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)",
      "Edit(benchtest/baselines/**)",
      "Write(benchtest/baselines/**)"
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "1000",
    "PYTHONIOENCODING": "utf-8"
  }
}
